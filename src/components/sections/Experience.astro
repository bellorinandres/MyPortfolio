---
import Area from "@/components/Area.astro";
import { formatDate } from "@/formatDate";
import { work } from "@cv";
---

<Area title="Experiência profissional">
  <ul>
    {
      work.map(
        ({ name, startDate, endDate, position, summary, highlights, url }) => {
          return (
            <li>
              <article>
                <header>
                  <div>
                    <h3>
                      {url ? (
                        <a
                          href={url}
                          title={`Ver ${name}`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {name}
                        </a>
                      ) : (
                        name
                      )}
                    </h3>
                    <h4>{position}</h4>
                  </div>

                  <div class="period">
                    <time datetime={startDate}>{formatDate(startDate)}</time>
                    {" - "}
                    {endDate ? <time datetime={endDate}>{formatDate(endDate)}</time> : "Atual"}
                  </div>
                </header>

                <footer>
                  <p>{summary}</p>
                  {highlights.length > 0 && (
                    <ul class="highlights">
                      {highlights.map((highlight) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  )}
                </footer>
              </article>
            </li>
          );
        }
      )
    }
  </ul>
</Area>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: var(--text);
  }

  article a {
    color: var(--text);
  }

  article a:hover {
    text-decoration: underline;
  }

  article h4 {
    color: var(--text-muted);
    font-weight: 400;
  }

  article footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .highlights {
    color: var(--text-muted);
    display: flex;
    flex-direction: column;
    font-size: 0.8rem;
    gap: 4px;
    list-style: disc;
    padding-left: 1rem;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  .period {
    color: var(--text-subtle);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  @media (width <= 700px) {
    header {
      flex-direction: column;
    }
  }
</style>
