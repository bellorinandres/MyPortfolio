---
import { Image } from "astro:assets";
import Area from "@/components/Area.astro";

import GitHub from "@/icons/GitHub.astro";
import { projects } from "@cv";

const screenshots = import.meta.glob<{ default: ImageMetadata }>("../../assets/projects/*.webp", {
  eager: true,
});
---

<Area title="Projetos">
  <ul>
    {
      projects.map(
        ({ url, description, highlights, name, isActive, github, image }) => {
          return (
            <li>
              <article>
                {/* Mesmo destino do título: fora do Tab e do leitor de tela para não duplicar o link. */}
                <a
                  class="screenshot-link no-print"
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={`Ver projeto ${name}`}
                  tabindex="-1"
                  aria-hidden="true"
                >
                  <Image
                    class="screenshot"
                    src={screenshots[`../../assets/projects/${image}`].default}
                    alt={`Tela inicial do projeto ${name}`}
                    widths={[400, 800]}
                    sizes="(width <= 700px) 90vw, 400px"
                  />
                </a>
                <header>
                  <h3>
                    <a
                      href={url}
                      target="_blank"
                      rel="noopener noreferrer"
                      title={`Ver projeto ${name}`}
                    >
                      {name}
                    </a>
                    {isActive && <span class="no-print">•</span>}
                    {github && (
                      <a
                        class="github-code-link no-print"
                        href={github}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Ver código-fonte do projeto ${name}`}
                        title={`Ver código-fonte do projeto ${name}`}
                      >
                        <GitHub />
                      </a>
                    )}
                  </h3>
                  <p class="no-print">{description}</p>
                  {[url, github].map(
                    (link) =>
                      link && (
                        <p class="print">
                          <a href={link}>{link.replace("https://", "")}</a>
                        </p>
                      )
                  )}
                </header>
                <footer>
                  {highlights.map((highlight) => {
                    return <span>{highlight}</span>;
                  })}
                </footer>
              </article>
            </li>
          );
        }
      )
    }
  </ul>
</Area>

<style>
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-inline: -16px;
  }

  article {
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    gap: 16px;
    display: flex;
    flex-direction: column;
    padding: 16px;
    height: 100%;
  }

  .screenshot-link:hover .screenshot {
    border-color: var(--accent);
  }

  .screenshot {
    display: block;
    aspect-ratio: 16 / 10;
    border: 1px solid var(--border);
    border-radius: 6px;
    height: auto;
    object-fit: cover;
    object-position: top;
    width: 100%;
  }

  article header {
    flex: 1;
  }

  article h3 {
    margin-bottom: 4px;
  }

  article a {
    color: var(--text);
  }

  article a:hover {
    text-decoration: underline;
  }

  article p {
    font-size: 0.75rem;
    line-height: 1.2rem;
    margin-bottom: 4px;
  }

  article h3 span {
    color: var(--accent);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    font-size: 0.6rem;
  }

  footer span {
    border-radius: 6px;
    background: var(--accent-soft);
    color: var(--text-muted);
    font-size: 0.6rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }

  .github-code-link {
    margin-left: 5px;
    vertical-align: middle;
  }

  .print a {
    overflow-wrap: anywhere;
  }

  @media print {
    ul {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-inline: 0;
    }

    article {
      background: none;
      border: 0;
      gap: 4px;
      padding: 0;
    }
  }

  @media (width <= 700px) {
    ul {
      margin-inline: 0px;
    }
  }

</style>
